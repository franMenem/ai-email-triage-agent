# Copy this file as .env and paste your real key there.
# .env is in .gitignore: it is NEVER committed. This .env.example is.
ANTHROPIC_API_KEY=sk-ant-...

# Secret for the public endpoints (/gmail-webhook, /renew-watch): any long random string.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_TOKEN=change-me
# Profile the webhook uses (freelance or store)
AGENT_PROFILE=freelance

# --- Mail provider ---------------------------------------------------------
# gmail (default) | outlook | imap
MAIL_PROVIDER=gmail
# Label (Gmail), category (Outlook) or folder (IMAP) the agent watches,
# or * for every incoming email (newsletters, notifications and no-reply skipped)
AGENT_FILTER=agente
# Public https address of the server (Outlook subscriptions call PUBLIC_URL/outlook-webhook)
PUBLIC_URL=https://your-app.fastapicloud.dev

# Gmail on a server: contents of token.json
# GMAIL_TOKEN_JSON=
# GMAIL_PUBSUB_TOPIC=projects/<your-project>/topics/gmail-agent

# Outlook / Microsoft 365
# MS_CLIENT_ID=
# On a server: contents of ms_token.json (created by `python outlook_client.py --login`)
# MS_TOKEN_CACHE=

# IMAP (iCloud, Yahoo, AOL, Zoho, GMX, Mail.com, Proton Bridge, any IMAP server)
# IMAP_PRESET=icloud
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=you@icloud.com
# IMAP_PASSWORD=an-app-password
